* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.bin binary
*.gz binary
*.icns binary
*.ico binary
*.jpg binary
*.jpeg binary
*.onnx binary
*.pdf binary
*.png binary
*.sqlite binary
*.wav binary
*.webp binary

# The release manifest records exact model byte lengths and hashes. Keep the
# tracked text artifacts in a single LF form on every checkout.
models/**/*.json text eol=lf
models/**/*.txt text eol=lf
