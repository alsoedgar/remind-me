{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remind-me.local/evals/documents/v0.1/corpus.schema.json",
  "title": "Remind Me document evaluation corpus row",
  "$ref": "#/$defs/record",
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "recurrence": {
      "type": ["object", "null"],
      "properties": {
        "frequency": { "enum": ["daily", "weekly", "monthly", "yearly"] },
        "interval": { "type": "integer", "minimum": 1, "maximum": 365 },
        "byWeekday": {
          "type": "array",
          "items": {
            "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
          },
          "uniqueItems": true
        },
        "byMonthDay": {
          "type": "array",
          "items": { "type": "integer", "minimum": -31, "maximum": 31 }
        },
        "end": {
          "oneOf": [
            {
              "type": "object",
              "properties": { "kind": { "const": "never" } },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "count" },
                "count": { "type": "integer", "minimum": 1 }
              },
              "required": ["kind", "count"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": { "kind": { "const": "until" }, "date": { "$ref": "#/$defs/date" } },
              "required": ["kind", "date"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["frequency", "interval", "byWeekday", "byMonthDay", "end"],
      "additionalProperties": false
    },
    "schedule": {
      "type": ["object", "null"],
      "properties": {
        "courseCode": { "type": "string", "minLength": 1 },
        "sectionCode": { "type": ["string", "null"] },
        "crn": { "type": ["string", "null"] },
        "component": {
          "enum": [
            "lecture",
            "lecture-discussion",
            "laboratory",
            "laboratory-discussion",
            "discussion",
            "seminar",
            "studio",
            "clinical",
            "practicum",
            "primary-section",
            "linked-section",
            "class-meeting"
          ]
        }
      },
      "required": ["courseCode", "sectionCode", "crn", "component"],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
        "page": { "type": "integer", "minimum": 1, "maximum": 100 },
        "kind": { "enum": ["event", "reminder"] },
        "title": { "type": "string", "minLength": 1 },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "startTime": { "$ref": "#/$defs/time" },
        "endTime": { "$ref": "#/$defs/time" },
        "timezone": { "type": "string", "minLength": 1 },
        "allDay": { "type": "boolean" },
        "location": { "type": ["string", "null"] },
        "recurrence": { "$ref": "#/$defs/recurrence" },
        "schedule": { "$ref": "#/$defs/schedule" }
      },
      "required": [
        "id",
        "page",
        "kind",
        "title",
        "startDate",
        "endDate",
        "startTime",
        "endTime",
        "timezone",
        "allDay",
        "location",
        "recurrence",
        "schedule"
      ],
      "additionalProperties": false
    },
    "skip": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "reason": {
          "enum": ["no-fixed-time", "non-calendar-content", "cancelled", "duplicate-source-row"]
        }
      },
      "required": ["id", "page", "title", "reason"],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
        "sourceGroupId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
        "fixture": { "type": "string", "pattern": "^fixtures/documents/[a-zA-Z0-9._-]+$" },
        "sourceKind": { "enum": ["pdf", "image"] },
        "mediaType": { "enum": ["application/pdf", "image/png", "image/jpeg", "image/webp"] },
        "inputClass": {
          "enum": [
            "born-digital",
            "raster-pdf",
            "hybrid-pdf",
            "direct-image",
            "screenshot",
            "phone-photo",
            "rotated-scan"
          ]
        },
        "layoutFamily": {
          "enum": [
            "vertical-list",
            "row-table",
            "syllabus",
            "calendar-grid",
            "itinerary-cards",
            "flyer"
          ]
        },
        "pageCount": { "type": "integer", "minimum": 1, "maximum": 20 },
        "locale": { "const": "en-US" },
        "timezone": { "type": "string", "minLength": 1 },
        "provenance": {
          "enum": ["project-sanitized", "consented-real", "independent-human-blind"]
        },
        "trainingExcluded": { "const": true },
        "independentHumanBlind": { "type": "boolean" },
        "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expectedItems": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "expectedSkips": { "type": "array", "items": { "$ref": "#/$defs/skip" } }
      },
      "required": [
        "id",
        "sourceGroupId",
        "fixture",
        "sourceKind",
        "mediaType",
        "inputClass",
        "layoutFamily",
        "pageCount",
        "locale",
        "timezone",
        "provenance",
        "trainingExcluded",
        "independentHumanBlind",
        "tags",
        "expectedItems",
        "expectedSkips"
      ],
      "additionalProperties": false
    }
  }
}
