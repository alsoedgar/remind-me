{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemindSpeak blinded preference response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "studyId", "participantId", "attestation", "judgments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "studyId": { "const": "remindspeak-v0.3-blind-a-b" },
    "participantId": { "type": "string", "pattern": "^anonymous-[a-z0-9-]{6,32}$" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanCompleted", "sourceKeyNotViewed"],
      "properties": { "humanCompleted": { "const": true }, "sourceKeyNotViewed": { "const": true } }
    },
    "judgments": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "preference", "factFaithfulness"],
        "properties": {
          "caseId": {
            "enum": [
              "proposal-cozy",
              "proposal-concise",
              "created-polished",
              "updated-cozy",
              "deleted-concise",
              "completed-cozy",
              "availability-free",
              "availability-busy",
              "summary-cozy",
              "summary-polished",
              "next-item-concise",
              "item-details-polished",
              "empty-cozy",
              "empty-concise",
              "conversation-cozy",
              "conversation-polished",
              "memory-cozy",
              "undo-concise",
              "rejected-cozy",
              "clarification-polished",
              "conflict-cozy",
              "unsupported-polished",
              "error-cozy",
              "details-concise"
            ]
          },
          "preference": { "enum": ["A", "B", "tie"] },
          "factFaithfulness": { "enum": ["A", "B", "both", "neither"] }
        }
      }
    }
  }
}
