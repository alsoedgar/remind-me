{
  "type": "object",
  "properties": {
    "kind": {
      "enum": ["answer", "clarification", "offline-limit", "refusal"]
    },
    "factRefs": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "ref": { "type": "string", "pattern": "^F(?:[1-9]|1[0-9]|2[0-4])$" },
          "factId": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "enum": [
                "title",
                "date",
                "time",
                "start",
                "end",
                "duration",
                "location",
                "notes",
                "recurrence",
                "details",
                "action",
                "status"
              ]
            }
          }
        },
        "required": ["ref", "factId", "fields"],
        "additionalProperties": false
      }
    },
    "text": { "type": "string", "minLength": 1 },
    "writeClaim": { "const": false }
  },
  "required": ["kind", "text", "factRefs", "writeClaim"],
  "additionalProperties": false
}
