{
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "disagreementId": { "type": "string", "minLength": 1 },
          "candidateId": { "type": ["string", "null"] },
          "citations": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "blockId": { "type": "string", "minLength": 1 },
                "page": { "type": "integer", "minimum": 1, "maximum": 20 },
                "role": {
                  "enum": ["title", "date", "time", "location", "description", "recurrence"]
                },
                "text": { "type": "string", "minLength": 1 },
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 1 }
              },
              "required": ["blockId", "page", "role", "text", "start", "end"],
              "additionalProperties": false
            }
          },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "required": ["disagreementId", "candidateId", "citations", "rationale"],
        "additionalProperties": false
      }
    }
  },
  "required": ["decisions"],
  "additionalProperties": false
}
