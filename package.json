{
  "name": "remind-me",
  "version": "0.1.4",
  "private": true,
  "description": "A cozy, local-first calendar and reminder assistant.",
  "author": "Remind Me contributors",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @remind-me/desktop dev",
    "build": "pnpm --filter @remind-me/desktop build",
    "start": "pnpm --filter @remind-me/desktop start",
    "smoke": "pnpm build && pnpm --filter @remind-me/desktop smoke",
    "package:dir": "pnpm release:prepare && pnpm --filter @remind-me/desktop package:dir",
    "package:installer": "pnpm release:prepare && pnpm --filter @remind-me/desktop package:installer",
    "package:audit": "tsx scripts/audit-package.ts",
    "package:artifacts:audit": "tsx scripts/audit-release-artifacts.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:generate": "tsx scripts/generate-golden-fixtures.ts",
    "fixtures:check": "tsx scripts/check-golden-fixtures.ts",
    "documents:fixtures:check": "tsx scripts/check-document-fixtures.ts",
    "document:inspect": "tsx apps/desktop/scripts/inspect-document-import.ts",
    "eval:documents:freeze": "pnpm document-assets:prepare && pnpm --filter @remind-me/desktop exec tsx scripts/evaluate-document-corpus.ts --freeze",
    "eval:documents:check": "pnpm --filter @remind-me/desktop exec tsx scripts/evaluate-document-corpus.ts --check",
    "eval:documents:baseline": "pnpm document-assets:prepare && pnpm --filter @remind-me/desktop exec tsx scripts/evaluate-document-corpus.ts",
    "documents:release:package": "tsx scripts/run-document-release-gate.ts",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "models:verify": "tsx scripts/verify-models.ts",
    "flex:benchmark": "pnpm --filter @remind-me/desktop exec node scripts/benchmark-flex-runtime.mjs",
    "flex:probe": "pnpm --filter @remind-me/desktop exec electron scripts/probe-flex-worker.mjs",
    "flex:quality:phase0": "pnpm --filter @remind-me/desktop exec electron scripts/probe-flex-worker.mjs --phase0-quality --summary-only",
    "eval:flex-model:phase6:check": "tsx scripts/check-flex-phase6.ts",
    "eval:flex-model:phase7:measure": "pnpm flex:quality:phase0",
    "eval:flex-model:phase7:check": "tsx scripts/check-flex-phase7.ts",
    "models:onnx:export": "python ml/export_onnx.py export",
    "models:onnx:check": "python ml/export_onnx.py check",
    "document-assets:prepare": "tsx scripts/prepare-document-assets.ts",
    "remindcore:generate": "python ml/remindcore/pipeline.py generate",
    "remindcore:train": "python ml/remindcore/pipeline.py all && pnpm remindcore-next:train",
    "remindcore:check": "tsx scripts/check-remindcore.ts",
    "remindcore-next:prepare": "tsx scripts/prepare-remindcore-next.ts",
    "remindcore-next:generate": "pnpm remindcore-next:prepare && node apps/desktop/scripts/qwen-teacher-generate.mjs assistant-next assistant-next-repairs",
    "remindcore-next:train": "pnpm remindcore-next:prepare && python ml/remindcore_next/pipeline.py train",
    "remindcore-next:check": "python ml/remindcore_next/pipeline.py check && tsx scripts/check-remindcore-next.ts",
    "remindspeak:generate": "python ml/remindspeak/pipeline.py generate",
    "remindspeak:train": "python ml/remindspeak/pipeline.py all",
    "remindspeak:check": "tsx scripts/check-remindspeak.ts",
    "remindspeak:study:prepare": "tsx scripts/remindspeak-preference-study.ts prepare",
    "remindspeak:study:score": "tsx scripts/remindspeak-preference-study.ts score",
    "remindspeak:study:gate": "tsx scripts/remindspeak-preference-study.ts score --require-gate",
    "planscan:generate": "python ml/planscan/pipeline.py generate",
    "planscan:train": "python ml/planscan/pipeline.py all",
    "planscan:check": "tsx scripts/check-planscan.ts",
    "teacher:generate": "python ml/teacher_assisted/pipeline.py prepare && node apps/desktop/scripts/qwen-teacher-generate.mjs core preferences",
    "teacher:generate:core": "node apps/desktop/scripts/qwen-teacher-generate.mjs core",
    "teacher:generate:speak": "python ml/teacher_assisted/pipeline.py prepare && node apps/desktop/scripts/qwen-teacher-generate.mjs preferences",
    "teacher:prepare": "python ml/teacher_assisted/pipeline.py prepare",
    "teacher:curate": "python ml/teacher_assisted/pipeline.py curate",
    "teacher:check": "python ml/teacher_assisted/pipeline.py check",
    "assistant-corpus:prepare": "tsx scripts/build-assistant-corpus.ts prepare",
    "assistant-corpus:generate": "pnpm assistant-corpus:prepare && node apps/desktop/scripts/qwen-teacher-generate.mjs assistant && tsx scripts/build-assistant-corpus.ts prepare-repairs && node apps/desktop/scripts/qwen-teacher-generate.mjs assistant-repairs",
    "assistant-corpus:repair": "tsx scripts/build-assistant-corpus.ts prepare-repairs && node apps/desktop/scripts/qwen-teacher-generate.mjs assistant-repairs",
    "assistant-corpus:curate": "tsx scripts/build-assistant-corpus.ts curate",
    "assistant-corpus:check": "tsx scripts/build-assistant-corpus.ts check",
    "eval:assistant:baseline": "tsx scripts/evaluate-assistant-baseline.ts",
    "eval:assistant:baseline:native": "tsx scripts/evaluate-assistant-baseline.ts --mode=native-hybrid",
    "eval:assistant:baseline:rules": "tsx scripts/evaluate-assistant-baseline.ts --mode=rules-only",
    "eval:assistant:contextual-phase0:generate": "tsx scripts/generate-assistant-contextual-phase0.ts",
    "eval:assistant:contextual-phase0:check": "tsx scripts/generate-assistant-contextual-phase0.ts --check",
    "eval:assistant:contextual-phase0:evaluate": "tsx scripts/evaluate-assistant-baseline.ts --suite=evals/assistant/contextual-phase0/scenarios.jsonl --manifest=evals/assistant/contextual-phase0/manifest.json --no-write --summary-only",
    "eval:assistant:contextual-phase7:generate": "tsx scripts/generate-assistant-contextual-phase7.ts",
    "eval:assistant:contextual-phase7:check": "tsx scripts/generate-assistant-contextual-phase7.ts --check",
    "eval:assistant:contextual-phase7:gate": "tsx scripts/evaluate-assistant-baseline.ts --suite=evals/assistant/contextual-phase7/scenarios.jsonl --manifest=evals/assistant/contextual-phase7/manifest.json --no-write --require-contextual-release --max-p95-ms=100 --summary-only",
    "eval:assistant:phase7": "tsx scripts/evaluate-assistant-baseline.ts --suite=evals/assistant/phase7/scenarios.jsonl --manifest=evals/assistant/phase7/manifest.json --no-write --require-gate --max-p95-ms=500",
    "eval:assistant:gate": "tsx scripts/evaluate-assistant-baseline.ts --no-write --require-gate --max-p95-ms=500 && pnpm eval:assistant:phase7",
    "eval:assistant:release-phase7:safety": "vitest run packages/storage/src/assistant-service.test.ts packages/storage/src/flex-chat-grounding.test.ts packages/assistant-core/src/contextual-resolver.test.ts",
    "eval:assistant:release-phase7": "pnpm eval:assistant:contextual-phase0:check && pnpm eval:assistant:contextual-phase7:check && pnpm eval:assistant:gate && pnpm eval:assistant:contextual-phase7:gate && pnpm eval:assistant:release-phase7:safety && pnpm eval:flex-model:phase6:check && pnpm eval:flex-model:phase7:check && pnpm eval:assistant:human-blind:boundary",
    "eval:assistant:human-blind:status": "tsx scripts/assistant-human-blind-cli.ts status",
    "eval:assistant:human-blind:validate": "pnpm remindcore:generate && tsx scripts/assistant-human-blind-cli.ts validate",
    "eval:assistant:human-blind:freeze": "pnpm remindcore:generate && tsx scripts/assistant-human-blind-cli.ts freeze",
    "eval:assistant:human-blind:boundary": "tsx scripts/assistant-human-blind-cli.ts boundary",
    "eval:assistant:human-blind:schema": "tsx scripts/generate-assistant-human-blind-schema.ts",
    "eval:assistant:human-blind:schema:check": "tsx scripts/generate-assistant-human-blind-schema.ts --check",
    "eval:assistant:human-blind:gate": "pnpm remindcore:generate && tsx scripts/evaluate-assistant-baseline.ts --require-human-blind --no-write --max-p95-ms=100",
    "eval:assistant:synthetic-phase8:generate": "tsx scripts/generate-assistant-synthetic-phase8.ts",
    "eval:assistant:synthetic-phase8:check": "tsx scripts/generate-assistant-synthetic-phase8.ts --check",
    "eval:assistant:synthetic-phase8:evaluate": "tsx scripts/evaluate-assistant-baseline.ts --suite=evals/assistant/synthetic-phase8/scenarios.jsonl --manifest=evals/assistant/synthetic-phase8/manifest.json --no-write",
    "eval:assistant:synthetic-phase8:gate": "tsx scripts/evaluate-assistant-baseline.ts --suite=evals/assistant/synthetic-phase8/scenarios.jsonl --manifest=evals/assistant/synthetic-phase8/manifest.json --no-write --require-gate --max-p95-ms=500",
    "release-probes:generate": "tsx scripts/generate-release-probes.ts",
    "release:prepare": "pnpm models:onnx:export && pnpm release-probes:generate && pnpm models:verify && pnpm models:onnx:check",
    "release:check": "tsx scripts/check-release.ts",
    "test": "pnpm fixtures:generate && vitest run",
    "verify": "pnpm release:prepare && pnpm release:check && pnpm remindcore:check && pnpm remindspeak:check && pnpm planscan:check && pnpm eval:assistant:release-phase7 && pnpm eval:assistant:synthetic-phase8:check && pnpm eval:assistant:human-blind:schema:check && pnpm document-assets:prepare && pnpm documents:fixtures:check && pnpm eval:documents:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm fixtures:check && pnpm --filter @remind-me/desktop smoke",
    "verify:model-research": "pnpm models:verify && pnpm teacher:check && pnpm assistant-corpus:check && pnpm remindcore:check && pnpm remindcore-next:check && pnpm eval:assistant:gate && pnpm eval:assistant:synthetic-phase8:check && pnpm eval:assistant:human-blind:schema:check && pnpm eval:assistant:human-blind:boundary && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm fixtures:check && pnpm --filter @remind-me/desktop smoke"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@remind-me/assistant-core": "workspace:*",
    "@remind-me/calendar-engine": "workspace:*",
    "@remind-me/contracts": "workspace:*",
    "@remind-me/model-runtime": "workspace:*",
    "@remind-me/storage": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.0.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  }
}
